{
  "name": "reacon-io/sdk",
  "description": "Official Reacon API client for PHP",
  "keywords": [
    "openapitools",
    "openapi-generator",
    "openapi",
    "php",
    "sdk",
    "rest",
    "api"
  ],
  "homepage": "https://github.com/reacon-io/reacon-php",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Reacon",
      "homepage": "https://github.com/reacon-io"
    }
  ],
  "require": {
    "php": "^8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "guzzlehttp/guzzle": "7.15.5",
    "guzzlehttp/psr7": "^1.7 || ^2.0",
    "symfony/http-client": "6.4.41"
  },
  "require-dev": {
    "phpunit/phpunit": "^8.0 || ^9.0",
    "friendsofphp/php-cs-fixer": "^3.5"
  },
  "autoload": {
    "psr-4": {
      "Reacon\\Sdk\\": "lib/"
    },
    "classmap": [
      "lib/Streaming/",
      "lib/Http/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Reacon\\Sdk\\Test\\": "test/"
    }
  }
}
